{
  "$description": "Clinic booking sample. Kinesiology tape on plaster: warm flat surfaces, ink edges, and one coral strip per screen.",
  "base": {
    "plaster": {
      "50": { "$type": "color", "$value": "#fcf9f3" },
      "100": { "$type": "color", "$value": "#f4eee3" },
      "200": { "$type": "color", "$value": "#e7decf" },
      "300": { "$type": "color", "$value": "#cdc2b8" }
    },
    "ink": {
      "500": { "$type": "color", "$value": "#75686f" },
      "700": { "$type": "color", "$value": "#544850" },
      "800": { "$type": "color", "$value": "#3a2f35" },
      "900": { "$type": "color", "$value": "#241b1f" }
    },
    "night": {
      "400": { "$type": "color", "$value": "#9a8d93" },
      "700": { "$type": "color", "$value": "#3a3237" },
      "800": { "$type": "color", "$value": "#2a2428" },
      "900": { "$type": "color", "$value": "#1e191c" }
    },
    "leaf": {
      "100": { "$type": "color", "$value": "#dceee3" },
      "300": { "$type": "color", "$value": "#86d3ac" },
      "700": { "$type": "color", "$value": "#1d6647" },
      "800": { "$type": "color", "$value": "#1c3a2c" }
    },
    "wine": {
      "100": { "$type": "color", "$value": "#f9dfe3" },
      "200": { "$type": "color", "$value": "#ffc6d0" },
      "300": { "$type": "color", "$value": "#ffa9b8" },
      "400": { "$type": "color", "$value": "#f78da0" },
      "600": { "$type": "color", "$value": "#b92c52" },
      "700": { "$type": "color", "$value": "#a01239" },
      "800": { "$type": "color", "$value": "#4a1a27" },
      "deep": { "$type": "color", "$value": "#7d0d2c" }
    },
    "size": {
      "1": { "$type": "dimension", "$value": { "value": 0.25, "unit": "rem" } },
      "2": { "$type": "dimension", "$value": { "value": 0.5, "unit": "rem" } },
      "3": { "$type": "dimension", "$value": { "value": 0.75, "unit": "rem" } },
      "4": { "$type": "dimension", "$value": { "value": 1, "unit": "rem" } },
      "6": { "$type": "dimension", "$value": { "value": 1.5, "unit": "rem" } },
      "8": { "$type": "dimension", "$value": { "value": 2, "unit": "rem" } },
      "11": { "$type": "dimension", "$value": { "value": 2.75, "unit": "rem" } },
      "13": { "$type": "dimension", "$value": { "value": 3.25, "unit": "rem" } },
      "22": { "$type": "dimension", "$value": { "value": 5.5, "unit": "rem" } },
      "80": { "$type": "dimension", "$value": { "value": 20, "unit": "rem" } }
    },
    "line": {
      "thin": { "$type": "dimension", "$value": { "value": 1, "unit": "px" } },
      "thick": { "$type": "dimension", "$value": { "value": 2, "unit": "px" } },
      "tick": { "$type": "dimension", "$value": { "value": 12, "unit": "px" } }
    },
    "radius": {
      "soft": { "$type": "dimension", "$value": { "value": 0.625, "unit": "rem" } },
      "card": { "$type": "dimension", "$value": { "value": 0.25, "unit": "rem" } },
      "round": { "$type": "dimension", "$value": { "value": 999, "unit": "rem" } }
    },
    "fontsize": {
      "1": { "$type": "dimension", "$value": { "value": 0.875, "unit": "rem" } },
      "2": { "$type": "dimension", "$value": { "value": 1.0625, "unit": "rem" } },
      "3": { "$type": "dimension", "$value": { "value": 1.3125, "unit": "rem" } },
      "4": { "$type": "dimension", "$value": { "value": 1.75, "unit": "rem" } },
      "5": { "$type": "dimension", "$value": { "value": 2.5, "unit": "rem" } }
    },
    "lineheight": {
      "tight": { "$type": "number", "$value": 1.2 },
      "body": { "$type": "number", "$value": 1.5 }
    },
    "weight": {
      "bold": { "$type": "fontWeight", "$value": 700 }
    },
    "font": {
      "text": { "$type": "fontFamily", "$value": "system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif" }
    },
    "duration": {
      "quick": { "$type": "duration", "$value": "100ms" },
      "settle": { "$type": "duration", "$value": "240ms" },
      "spin": { "$type": "duration", "$value": "900ms" }
    },
    "curve": {
      "press": { "$type": "cubicBezier", "$value": "cubic-bezier(0.2, 0.8, 0.2, 1)" }
    },
    "ratio": {
      "press": { "$type": "number", "$value": 0.98 }
    },
    "coral": {
      "300": { "$type": "color", "$value": "#ff9f88" },
      "400": { "$type": "color", "$value": "#ff8062" },
      "500": { "$type": "color", "$value": "#f56a48" },
      "muted": { "$type": "color", "$value": "#ee8a72" },
      "mutedlight": { "$type": "color", "$value": "#f4a592" },
      "muteddeep": { "$type": "color", "$value": "#e27a61" }
    }
  },
  "semantic": {
    "color": {
      "surface": { "$type": "color", "$value": "{base.plaster.100}", "$extensions": { "design": { "modes": { "dark": "{base.night.900}" } } } },
      "raised": { "$type": "color", "$value": "{base.plaster.50}", "$extensions": { "design": { "modes": { "dark": "{base.night.800}" } } } },
      "sunken": { "$type": "color", "$value": "{base.plaster.200}", "$extensions": { "design": { "modes": { "dark": "{base.night.700}" } } } },
      "text": { "$type": "color", "$value": "{base.ink.900}", "$extensions": { "design": { "modes": { "dark": "{base.plaster.100}" } } } },
      "muted": { "$type": "color", "$value": "{base.ink.700}", "$extensions": { "design": { "modes": { "dark": "{base.plaster.300}" } } } },
      "edge": { "$type": "color", "$value": "{base.ink.500}", "$extensions": { "design": { "modes": { "dark": "{base.night.400}" } } } },
      "edge-strong": { "$type": "color", "$value": "{base.ink.900}", "$extensions": { "design": { "modes": { "dark": "{base.plaster.100}" } } } },
      "focus": { "$type": "color", "$value": "{base.ink.900}", "$extensions": { "design": { "modes": { "dark": "{base.plaster.50}" } } } },
      "action": { "$type": "color", "$value": "{base.ink.900}", "$extensions": { "design": { "modes": { "dark": "{base.plaster.100}" } } } },
      "action-hover": { "$type": "color", "$value": "{base.ink.700}", "$extensions": { "design": { "modes": { "dark": "{base.plaster.50}" } } } },
      "action-pressed": { "$type": "color", "$value": "{base.ink.800}", "$extensions": { "design": { "modes": { "dark": "{base.plaster.200}" } } } },
      "on-action": { "$type": "color", "$value": "{base.plaster.50}", "$extensions": { "design": { "modes": { "dark": "{base.night.900}" } } } },
      "marker": { "$type": "color", "$value": "{base.coral.400}", "$extensions": { "design": { "modes": { "dark": "{base.coral.muted}" } } } },
      "marker-hover": { "$type": "color", "$value": "{base.coral.300}", "$extensions": { "design": { "modes": { "dark": "{base.coral.mutedlight}" } } } },
      "marker-pressed": { "$type": "color", "$value": "{base.coral.500}", "$extensions": { "design": { "modes": { "dark": "{base.coral.muteddeep}" } } } },
      "marker-edge": { "$type": "color", "$value": "{base.ink.900}", "$extensions": { "design": { "modes": { "dark": "{base.coral.muted}" } } } },
      "on-marker": { "$type": "color", "$value": "{base.ink.900}" },
      "success": { "$type": "color", "$value": "{base.leaf.700}", "$extensions": { "design": { "modes": { "dark": "{base.leaf.300}" } } } },
      "success-tint": { "$type": "color", "$value": "{base.leaf.100}", "$extensions": { "design": { "modes": { "dark": "{base.leaf.800}" } } } },
      "error": { "$type": "color", "$value": "{base.wine.700}", "$extensions": { "design": { "modes": { "dark": "{base.wine.300}" } } } },
      "error-hover": { "$type": "color", "$value": "{base.wine.600}", "$extensions": { "design": { "modes": { "dark": "{base.wine.200}" } } } },
      "error-pressed": { "$type": "color", "$value": "{base.wine.deep}", "$extensions": { "design": { "modes": { "dark": "{base.wine.400}" } } } },
      "on-error": { "$type": "color", "$value": "{base.plaster.50}", "$extensions": { "design": { "modes": { "dark": "{base.night.900}" } } } },
      "error-tint": { "$type": "color", "$value": "{base.wine.100}", "$extensions": { "design": { "modes": { "dark": "{base.wine.800}" } } } }
    },
    "space": {
      "hair": { "$type": "dimension", "$value": "{base.size.1}" },
      "tight": { "$type": "dimension", "$value": "{base.size.2}" },
      "control": { "$type": "dimension", "$value": "{base.size.3}" },
      "group": { "$type": "dimension", "$value": "{base.size.4}" },
      "card": { "$type": "dimension", "$value": "{base.size.6}" },
      "section": { "$type": "dimension", "$value": "{base.size.8}" }
    },
    "control": {
      "height": { "$type": "dimension", "$value": "{base.size.13}" },
      "height-compact": { "$type": "dimension", "$value": "{base.size.11}" },
      "edge": { "$type": "dimension", "$value": "{base.line.thick}" },
      "divider": { "$type": "dimension", "$value": "{base.line.thin}" }
    },
    "shape": {
      "control": { "$type": "dimension", "$value": "{base.radius.soft}" },
      "card": { "$type": "dimension", "$value": "{base.radius.card}" },
      "round": { "$type": "dimension", "$value": "{base.radius.round}" }
    },
    "type": {
      "small": { "$type": "dimension", "$value": "{base.fontsize.1}" },
      "body": { "$type": "dimension", "$value": "{base.fontsize.2}" },
      "lead": { "$type": "dimension", "$value": "{base.fontsize.3}" },
      "title": { "$type": "dimension", "$value": "{base.fontsize.3}" },
      "display": { "$type": "dimension", "$value": "{base.fontsize.4}" },
      "time": { "$type": "dimension", "$value": "{base.fontsize.5}" }
    },
    "leading": {
      "tight": { "$type": "number", "$value": "{base.lineheight.tight}" },
      "body": { "$type": "number", "$value": "{base.lineheight.body}" }
    },
    "emphasis": {
      "strong": { "$type": "fontWeight", "$value": "{base.weight.bold}" }
    },
    "typeface": {
      "text": { "$type": "fontFamily", "$value": "{base.font.text}" }
    },
    "motion": {
      "quick": { "$type": "duration", "$value": "{base.duration.quick}" },
      "settle": { "$type": "duration", "$value": "{base.duration.settle}" },
      "spin": { "$type": "duration", "$value": "{base.duration.spin}" },
      "curve": { "$type": "cubicBezier", "$value": "{base.curve.press}" },
      "press": { "$type": "number", "$value": "{base.ratio.press}" }
    },
    "measure": {
      "skeleton": { "$type": "dimension", "$value": "{base.size.4}" },
      "aside": { "$type": "dimension", "$value": "{base.size.80}" },
      "time-column": { "$type": "dimension", "$value": "{base.size.22}" },
      "tick": { "$type": "dimension", "$value": "{base.line.tick}" }
    }
  },
  "component": {
    "button": {
      "height": { "$type": "dimension", "$value": "{semantic.control.height}" },
      "height-compact": { "$type": "dimension", "$value": "{semantic.control.height-compact}" },
      "padding": { "$type": "dimension", "$value": "{semantic.space.group}" }
    },
    "slot": {
      "height": { "$type": "dimension", "$value": "{semantic.control.height}" },
      "overhang": { "$type": "dimension", "$value": "{semantic.space.tight}" },
      "time-width": { "$type": "dimension", "$value": "{semantic.measure.time-column}" },
      "time-size": { "$type": "dimension", "$value": "{semantic.type.display}" }
    },
    "rail": {
      "inset": { "$type": "dimension", "$value": "{semantic.space.group}" },
      "tick-length": { "$type": "dimension", "$value": "{semantic.control.divider}" },
      "tick-gap": { "$type": "dimension", "$value": "{semantic.measure.tick}" }
    },
    "field": {
      "height": { "$type": "dimension", "$value": "{semantic.control.height}" }
    },
    "link": {
      "height": { "$type": "dimension", "$value": "{semantic.control.height-compact}" }
    },
    "ticket": {
      "strip": { "$type": "dimension", "$value": "{semantic.space.control}" }
    },
    "day": {
      "height": { "$type": "dimension", "$value": "{semantic.control.height}" }
    },
    "notice": {
      "edge": { "$type": "dimension", "$value": "{semantic.space.control}" }
    },
    "skeleton": {
      "height": { "$type": "dimension", "$value": "{semantic.measure.skeleton}" },
      "height-tall": { "$type": "dimension", "$value": "{semantic.control.height}" }
    },
    "daylist": {
      "time-width": { "$type": "dimension", "$value": "{semantic.measure.time-column}" },
      "title-size": { "$type": "dimension", "$value": "{semantic.type.display}" }
    },
    "icon": {
      "size": { "$type": "dimension", "$value": "{semantic.type.lead}" }
    },
    "spinner": {
      "size": { "$type": "dimension", "$value": "{semantic.space.group}" }
    }
  }
}
