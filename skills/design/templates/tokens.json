{
  "$description": "Structure only. Create system replaces every value and name with the project's own; nothing here is a house style.",
  "base": {
    "gray": {
      "50": { "$type": "color", "$value": "#fafafa" },
      "900": { "$type": "color", "$value": "#1a1a1a" }
    },
    "brand": {
      "500": { "$type": "color", "$value": "#2563eb" }
    },
    "size": {
      "1": { "$type": "dimension", "$value": { "value": 4, "unit": "px" } },
      "2": { "$type": "dimension", "$value": { "value": 8, "unit": "px" } },
      "4": { "$type": "dimension", "$value": { "value": 16, "unit": "px" } }
    },
    "font": {
      "body": { "$type": "fontFamily", "$value": "system-ui, sans-serif" }
    }
  },
  "semantic": {
    "color": {
      "surface": {
        "$type": "color",
        "$value": "{base.gray.50}",
        "$extensions": { "design": { "modes": { "dark": "{base.gray.900}" } } }
      },
      "text": {
        "$type": "color",
        "$value": "{base.gray.900}",
        "$extensions": { "design": { "modes": { "dark": "{base.gray.50}" } } }
      },
      "action": { "$type": "color", "$value": "{base.brand.500}" }
    },
    "space": {
      "control": { "$type": "dimension", "$value": "{base.size.2}" },
      "section": { "$type": "dimension", "$value": "{base.size.4}" }
    },
    "typeface": {
      "body": { "$type": "fontFamily", "$value": "{base.font.body}" }
    }
  },
  "component": {
    "button": {
      "bg": { "$type": "color", "$value": "{semantic.color.action}" },
      "text": { "$type": "color", "$value": "{semantic.color.surface}" },
      "padding": { "$type": "dimension", "$value": "{semantic.space.control}" }
    }
  }
}
