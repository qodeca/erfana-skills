# macOS
.DS_Store
**/.DS_Store

# Node / editor / OS
node_modules/
*.swp
.idea/
.vscode/
Thumbs.db

# Claude Code local state (per-machine; keep rest of .claude/ trackable)
.claude/scheduled_tasks.lock
.claude/settings.local.json

# Doc-update protocol scratch space (per-invocation; deleted at protocol step 13)
temp/

# Modernize/Modify backup directories (ms-modifier creates these per atomic-rollback contract)
.backups-*/
**/.backups-*/

# Python bytecode cache
__pycache__/
*.pyc

# Local-only working files (reports, scratch); never committed
.local/
